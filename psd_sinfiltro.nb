Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Cargar", " ", "los", " ", "datos", " ", "del", " ", "archivo"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Import", "[", 
      RowBox[{
      "\"\</Users/keniajuayerk/Desktop/k_channel.txt\>\"", ",", 
       "\"\<Table\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extraer", " ", "los", " ", "tiempos", " ", "y", " ", "valores"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"time", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"values", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calcular", " ", "la", " ", "longitud", " ", "de", " ", "los", " ", 
     "datos"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "values", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calcular", " ", "el", " ", "per\[IAcute]odo", " ", "de", " ", "muestreo",
      " ", 
     RowBox[{"(", 
      RowBox[{"asumiendo", " ", "intervalos", " ", "regulares"}], ")"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"samplingPeriod", "=", 
     RowBox[{
      RowBox[{"time", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "-", 
      RowBox[{"time", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calcular", " ", "la", " ", "frecuencia", " ", "de", " ", "muestreo"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"samplingFrequency", "=", 
     RowBox[{"1", "/", "samplingPeriod"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Calcular", " ", "la", " ", "transformada", " ", "de", " ", "Fourier"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"fourier", "=", 
     RowBox[{"Fourier", "[", 
      RowBox[{"values", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calcular", " ", "la", " ", "PSD"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"psd", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "fourier", "]"}], "^", "2"}], "/", "n"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Crear", " ", "las", " ", "frecuencias", " ", "correspondientes"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"frequencies", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "-", "1"}], ")"}], "*", 
        RowBox[{"samplingFrequency", "/", "n"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Graficar", " ", "la", " ", "PSD", " ", "en", " ", "escala", " ", 
     "logar\[IAcute]tmica"}], "*)"}], "\n", 
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"frequencies", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"Floor", "[", 
            RowBox[{"n", "/", "2"}], "]"}]}], "]"}], "]"}], ",", 
        RowBox[{"psd", "[", 
         RowBox[{"[", 
          RowBox[{"1", ";;", 
           RowBox[{"Floor", "[", 
            RowBox[{"n", "/", "2"}], "]"}]}], "]"}], "]"}]}], "}"}], "]"}], 
     ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Frecuencia (Hz)\>\"", ",", "\"\<PSD\>\""}], "}"}]}], ",", 
     
     RowBox[{
     "PlotLabel", "->", "\"\<Densidad Espectral de Potencia (PSD)\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Ajustar", " ", "una", " ", "ley", " ", "de", " ", "potencia", " ", "a", 
     " ", "la", " ", "PSD", " ", "para", " ", "estimar", " ", "beta"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Consideramos", " ", "solo", " ", "las", " ", "frecuencias", " ", "bajas",
      " ", "para", " ", "el", " ", "ajuste"}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"lowFreqRange", "=", 
     RowBox[{"Floor", "[", 
      RowBox[{"n", "/", "10"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Ajustar", " ", "este", " ", "valor", " ", "seg\[UAcute]n", " ", "sea", 
     " ", "necesario"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Preparar", " ", "los", " ", "datos", " ", "para", " ", "el", " ", 
     "ajuste"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"fitData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"frequencies", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", "lowFreqRange"}], "]"}], "]"}], "]"}], ",", 
        RowBox[{"Log", "[", 
         RowBox[{"psd", "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", "lowFreqRange"}], "]"}], "]"}], "]"}]}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Realizar", " ", "el", " ", "ajuste", " ", "lineal"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"fit", "=", 
     RowBox[{"LinearModelFit", "[", 
      RowBox[{"fitData", ",", "x", ",", "x"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Extraer", " ", "la", " ", "pendiente", " ", 
     RowBox[{"(", "beta", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"beta", "=", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"fit", "[", "\"\<BestFitParameters\>\"", "]"}], "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Mostrar", " ", "el", " ", "valor", " ", "de", " ", "beta"}], 
    "*)"}], "\n", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<El valor estimado de beta es: \>\"", ",", "beta"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Graficar", " ", "el", " ", "ajuste"}], "*)"}], "\n", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{"fitData", ",", 
       RowBox[{"PlotStyle", "->", "Red"}], ",", 
       RowBox[{"PlotLabel", "->", "\"\<Ajuste para estimar beta\>\""}]}], 
      "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"fit", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Min", "[", 
          RowBox[{"fitData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"fitData", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Log(Frecuencia)\>\"", ",", "\"\<Log(PSD)\>\""}], "}"}]}], 
     ",", 
     RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.962720460408428*^9, 3.9627204965028257`*^9}, {
  3.962724303639797*^9, 3.962724305142686*^9}},
